#include <stdio.h>

typedef struct {
    char name[50];
    int roll_no;
    char mobile_no[15];
    float CGPA;
    char DoB[15];
    char course[50];
    int year;
} Student;

void input(Student *s);
void display(Student s);
Student findTopper(Student s[], int n);

void main()
{
    Student students[10];
    Student topper;
    int i;

    for(i = 0; i < 10; i++)
    {
        printf("\nEnter details of student %d:\n", i + 1);
        input(&students[i]);
    }

    topper = findTopper(students, 10);

    printf("\n--- Topper of the Class ---\n");
    display(topper);
}

void input(Student *s)
{
    printf("Enter Name: ");
    scanf(" %[^\n]", s->name);

    printf("Enter Roll No: ");
    scanf("%d", &s->roll_no);

    printf("Enter Mobile No: ");
    scanf("%s", s->mobile_no);

    printf("Enter CGPA: ");
    scanf("%f", &s->CGPA);

    printf("Enter Date of Birth (DD/MM/YYYY): ");
    scanf("%s", s->DoB);

    printf("Enter Course: ");
    scanf(" %[^\n]", s->course);

    printf("Enter Year: ");
    scanf("%d", &s->year);
}

void display(Student s)
{
    printf("Name: %s\n", s.name);
    printf("Roll No: %d\n", s.roll_no);
    printf("Mobile No: %s\n", s.mobile_no);
    printf("CGPA: %.2f\n", s.CGPA);
    printf("Date of Birth: %s\n", s.DoB);
    printf("Course: %s\n", s.course);
    printf("Year: %d\n", s.year);
}

Student findTopper(Student s[], int n)
{
    int i;
    Student topper = s[0];

    for(i = 1; i < n; i++)
    {
        if(s[i].CGPA > topper.CGPA)
        {
            topper = s[i];
        }
    }

    return topper;
}
